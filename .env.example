# =============================================================================
# 0DTE Auto-Trader configuration
# Copy to `.env` and fill in. Anything left blank falls back to a safe default.
# =============================================================================

# ----- Data mode -------------------------------------------------------------
# "mock" -> self-contained synthetic feed (dashboard runs with zero deps).
# "live" -> talk to the real MM + Gammagamma + Schwab services.
DATA_MODE=mock

# Comma-separated tickers to trade (long-only).
TICKERS=QQQ,SPY

# ----- Safety / execution ----------------------------------------------------
# DRY_RUN=true never sends a real order to Schwab; it simulates fills locally.
# Flip to false ONLY once you have verified everything end-to-end.
DRY_RUN=true

# Contracts per entry (long calls only).
CONTRACTS=1

# Proximity band in dollars: "within $1 of a level".
PROXIMITY=1.0

# 0DTE call strike = mid level + this offset. Spec: $1 above mid.
STRIKE_OFFSET=1.0

# Poll cadence (seconds).
QUOTE_POLL_SECONDS=5
LEVELS_POLL_SECONDS=60
MM_POLL_SECONDS=15

# ----- MM service (Biggjuann/MM) --------------------------------------------
# Provides: shared Schwab dev token, trend status (stance), puts/calls volume.
MM_BASE_URL=https://web-production-fff5c.up.railway.app
# Optional: only used as a fallback for SCHWAB_TOKEN_SHARE_KEY below.
MM_API_KEY=

# ----- Gammagamma service (Biggjuann/Gammagamma) ----------------------------
# Provides: structural levels (call/put walls, gamma flip, GVWAP).
# Use the API backend URL (the divine-celebration frontend is auto-redirected).
GAMMA_BASE_URL=https://gammagamma-production.up.railway.app
GAMMA_API_KEY=
# Expiries to read levels from (comma-separated). The channel bounds use the
# highest call wall and lowest put wall ACROSS these expiries.
GAMMA_EXPIRY=weekly,0dte

# ----- Schwab Trader API -----------------------------------------------------
SCHWAB_BASE_URL=https://api.schwabapi.com
# Account hash the orders are routed to (required only when DRY_RUN=false).
SCHWAB_ACCOUNT_HASH=

# ----- Shared Schwab token (mirrors the MM service's variables) --------------
# "shared" pulls the access token over HTTP so this app shares MM's single
# Schwab authorization (market data + options trading).
SCHWAB_AUTH_MODE=shared
# Token endpoint. Leave blank to default to MM_BASE_URL + /auth/token.
SCHWAB_TOKEN_URL=https://web-production-fff5c.up.railway.app/auth/token
# Bearer key presented to the token endpoint (== MM's SCHWAB_TOKEN_SHARE_KEY).
SCHWAB_TOKEN_SHARE_KEY=
# Where underlying quotes / option chains come from: "schwab" or "gammagamma".
# Orders always route through Schwab regardless of these.
MARKET_DATA_PROVIDER=schwab
OPTIONS_PROVIDER=schwab

# ----- Gamma strategy risk controls -----------------------------------------
BREAKEVEN_ARM_PROFIT=1.0      # arm a breakeven stop once open profit hits +100%
                              # (premium doubles). 0 disables it.
STOP_COOLDOWN_SECONDS=180     # after a STOP, sit out this long before re-entering
REARM_DISTANCE=0              # $ above put wall needed to re-arm (0 = use PROXIMITY)

# ----- Regular-trading-hours gate (BOTH strategies, US/Eastern) -------------
# 0DTE options trade RTH only: no entries outside the session, and any open
# position is flattened before the close. Set RTH_ONLY=false only for off-hours
# mock demos.
RTH_ONLY=true
SESSION_OPEN=09:30
SESSION_CLOSE=16:00
SESSION_NO_ENTRY=15:45        # stop opening new trades this late
SESSION_FLATTEN=15:55         # force-flat any open 0DTE by this time

# ----- Person's Pivots strategy (second tab) --------------------------------
PIVOT_CONTRACTS=4            # ATM contracts per zone-fade trade
# Each pivot level is a ZONE this wide (dollars), line centered; a level is
# "hit" when price enters its zone. Per ticker, comma-separated.
PIVOT_ZONES=SPY:0.50,QQQ:0.75
PIVOT_PROXIMITY=0.5          # fallback zone half-width for tickers without a zone
PIVOT_SCALE_PROFIT=0.5       # sell down to the runner once premium is +50%
PIVOT_RUNNER_CONTRACTS=1     # contracts left to run to the next zone
PIVOT_STOP_PCT=0             # 0 = NO stop (runners go zone-to-zone/EOD). >0 re-enables + breakeven-on-scale
VIX_SYMBOL=$VIX              # Schwab symbol shown as context (no longer gates entries)
# bad-data guards: a single spiked/stale print must not trigger a trade
PIVOT_MAX_DEV_PCT=0.03       # reject decision price >3% from prior close
PIVOT_MAX_JUMP_PCT=0.02      # reject >2% move between consecutive ticks
PIVOT_MIN_HOLD_SECONDS=3     # no scale/stop/target in the first N seconds
# PIVOT_TRADE_LOG_PATH=/data/pivot_trades.json   # mount a Volume to persist

# ----- Trade log -------------------------------------------------------------
# JSON trade log path. On Railway, mount a Volume (e.g. at /data) and set this
# to a file inside it so the log survives redeploys. Blank -> app/data/trades.json.
TRADE_LOG_PATH=/data/trades.json

# ----- Dashboard -------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
