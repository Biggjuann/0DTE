# =============================================================================
# 0DTE Auto-Trader configuration
# Copy to `.env` and fill in. Anything left blank falls back to a safe default.
# =============================================================================

# ----- Data mode -------------------------------------------------------------
# "mock" -> self-contained synthetic feed (dashboard runs with zero deps).
# "live" -> talk to the real MM + Gammagamma + Schwab services.
DATA_MODE=mock

# Comma-separated tickers to trade (long-only).
TICKERS=QQQ,SPY

# ----- Safety / execution ----------------------------------------------------
# DRY_RUN=true never sends a real order to Schwab; it simulates fills locally.
# Flip to false ONLY once you have verified everything end-to-end.
DRY_RUN=true

# Contracts per entry (long calls only).
CONTRACTS=1

# Proximity band in dollars: "within $1 of a level".
PROXIMITY=1.0

# 0DTE call strike = mid level + this offset. Spec: $1 above mid.
STRIKE_OFFSET=1.0

# Poll cadence (seconds).
QUOTE_POLL_SECONDS=5
LEVELS_POLL_SECONDS=60
MM_POLL_SECONDS=15

# ----- MM service (Biggjuann/MM) --------------------------------------------
# Provides: shared Schwab dev token, trend status (stance), puts/calls volume.
MM_BASE_URL=https://web-production-fff5c.up.railway.app
# Optional: only used as a fallback for SCHWAB_TOKEN_SHARE_KEY below.
MM_API_KEY=

# ----- Gammagamma service (Biggjuann/Gammagamma) ----------------------------
# Provides: structural levels (call/put walls, gamma flip, GVWAP).
# Use the API backend URL (the divine-celebration frontend is auto-redirected).
GAMMA_BASE_URL=https://gammagamma-production.up.railway.app
GAMMA_API_KEY=
# Expiry to read levels from: "weekly" (spec), "0dte", "all", or YYYY-MM-DD.
GAMMA_EXPIRY=weekly

# ----- Schwab Trader API -----------------------------------------------------
SCHWAB_BASE_URL=https://api.schwabapi.com
# Account hash the orders are routed to (required only when DRY_RUN=false).
SCHWAB_ACCOUNT_HASH=

# ----- Shared Schwab token (mirrors the MM service's variables) --------------
# "shared" pulls the access token over HTTP so this app shares MM's single
# Schwab authorization (market data + options trading).
SCHWAB_AUTH_MODE=shared
# Token endpoint. Leave blank to default to MM_BASE_URL + /auth/token.
SCHWAB_TOKEN_URL=https://web-production-fff5c.up.railway.app/auth/token
# Bearer key presented to the token endpoint (== MM's SCHWAB_TOKEN_SHARE_KEY).
SCHWAB_TOKEN_SHARE_KEY=
# Where underlying quotes / option chains come from: "schwab" or "gammagamma".
# Orders always route through Schwab regardless of these.
MARKET_DATA_PROVIDER=schwab
OPTIONS_PROVIDER=schwab

# ----- Dashboard -------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
